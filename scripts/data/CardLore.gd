static func description_for(cfg) -> String:
	if cfg == null:
		return ""
	var n := String(cfg.card_name)
	if DESC.has(n):
		return String(DESC[n])
	if int(cfg.attack_speed) <= 0 and int(cfg.type) != 1:
		return TYPE_FALLBACK["spell"]
	if int(cfg.type) == 1:
		return TYPE_FALLBACK["building"]
	if int(cfg.target_type) == 1:
		return TYPE_FALLBACK["building_only"]
	if int(cfg.type) == 3:
		return TYPE_FALLBACK["air"]
	if float(cfg.max_health) >= 2500.0:
		return TYPE_FALLBACK["tank"]
	if float(cfg.damage_range) > 0.5:
		return TYPE_FALLBACK["splash"]
	if int(cfg.num) >= 3:
		return TYPE_FALLBACK["swarm"]
	if float(cfg.attack_range) >= 5.0:
		return TYPE_FALLBACK["ranged"]
	return TYPE_FALLBACK["melee"]
