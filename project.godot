; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="clash_royale"
run/main_scene="uid://x1weo8y8kieb"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Config="*res://scripts/core/Config.gd"
GameManager="*res://scripts/core/GameManager.gd"
AudioManager="*res://scripts/core/AudioManager.gd"
GameSettings="*res://scripts/core/GameSettings.gd"
PlayerData="*res://scripts/data/PlayerData.gd"
ThemeHelper="*res://assets/ui/ThemeHelper.gd"
UiComponents="*res://assets/ui/UiComponents.gd"
LootLockerSDK="*res://addons/LootLockerSDK/LootLockerSDK_Autoload.gd"
LeaderboardAPI="*res://scripts/core/LeaderboardAPI.gd"
AccountManager="*res://scripts/core/AccountManager.gd"
ClanManager="*res://scripts/core/ClanManager.gd"
NetworkManager="*res://scripts/net/NetworkManager.gd"
FriendManager="*res://scripts/core/FriendManager.gd"
LoadingScreen="*res://scripts/core/LoadingScreen.gd"
WebTextCompat="*res://scripts/core/WebTextCompat.gd"

[display]

window/size/viewport_width=800
window/size/viewport_height=1600
window/size/mode=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/LootLockerSDK/plugin.cfg")

[filesystem]

import/blender/enabled=false

[gui]

theme/custom_font="res://assets/fonts/STZHONGS.TTF"
theme/custom_default_font_size=16

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=0
